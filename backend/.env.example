# ============================================================================
# CONFIGURATION ENVIRONNEMENT - CENHOSOA-SMCV
# ============================================================================
# Copier ce fichier en ".env" et remplir les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" (voir .gitignore).

# Application
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
API_VERSION=v1

# Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=postgres

# JWT Security
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Ne jamais réutiliser la valeur de dev en prod, ni entre développeurs.
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# SMTP (Brevo / Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CENHOSOA-SMCV <no-reply@example.com>"
